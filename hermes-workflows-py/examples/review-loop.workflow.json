{
  "id": "review-loop-smoke",
  "name": "Review loop smoke test (no model calls)",
  "version": 1,
  "scope": { "type": "global" },
  "trigger": { "type": "manual" },
  "nodes": [
    { "id": "start", "type": "prompt", "prompt": "Review each iteration before finishing." },
    { "id": "work", "type": "script", "shell": "shell", "command": "echo Ready for review", "timeout_seconds": 30 },
    { "id": "review", "type": "human_review", "title": "Approve or request another iteration", "options": ["approved", "needs_changes", "rejected"] },
    { "id": "done", "type": "finish", "outcome": "success" },
    { "id": "rejected", "type": "finish", "outcome": "failure" }
  ],
  "edges": [
    { "from": "start", "to": "work" },
    { "from": "work", "to": "review" },
    { "from": "review", "to": "work", "condition": { "type": "review_status", "equals": "needs_changes" } },
    { "from": "review", "to": "done", "condition": { "type": "review_status", "equals": "approved" } },
    { "from": "review", "to": "rejected", "condition": { "type": "review_status", "equals": "rejected" } }
  ]
}
