  "workflows": {
    "feature": {
      "id": "feature-development",
      "name": "Feature Development",
      "version": 1,
      "scope": {
        "type": "project"
      },
      "trigger": {
        "type": "manual"
      },
      "defaults": {
        "profile": "fullstack-engineer",
        "max_retries": 1,
        "memory": {
          "provider": "auto",
          "fail_open": true
        }
      },
      "params": [
        {
          "name": "feature_request",
          "type": "text",
          "label": "Feature request",
          "required": true,
          "help": "What the operator wants built, in their own words. Captured before the plan node and interpolated into the Plan feature card so the plan is grounded in a concrete request rather than a generic prompt. Filled from the dashboard form, the /workflow slash command, or a chat deep-link. No default: a run started without it fails closed rather than feeding the plan node a circular placeholder."
        }
      ],
      "nodes": [
        {
          "id": "plan",
          "type": "agent_task",
          "title": "Plan feature",
          "profile": "product-tech-lead",
          "prompt": "Convert the operator's feature request into a concrete implementation plan.\n\nFeature request:\n{{params.feature_request}}\n\nReturn tasks, risks, files likely to change, and validation steps.\n"
        },
        {
          "id": "implement",
          "type": "agent_task",
          "title": "Implement feature",
          "profile": "fullstack-engineer",
          "workspace": {
            "type": "worktree"
          },
          "prompt": "Implement the feature according to the plan.\n"
        },
        {
          "id": "validate",
          "type": "agent_task",
          "title": "Validate implementation",
          "profile": "qa-engineer",
          "prompt": "Run lint and tests. Report node outcome success when clean, failure otherwise.\n"
        },
        {
          "id": "fix",
          "type": "agent_task",
          "title": "Fix validation errors",
          "profile": "fullstack-engineer",
          "prompt": "Fix the validation errors reported by the previous node.\n"
        },
        {
          "id": "review",
          "type": "human_review",
          "title": "Final human review",
          "options": [
            "approved",
            "rejected",
            "needs_changes"
          ]
        },
        {
          "id": "release_notes",
          "type": "agent_task",
          "title": "Prepare release notes",
          "profile": "product-tech-lead",
          "prompt": "Prepare release notes for the merged feature.\n"
        },
        {
          "id": "done",
          "type": "finish",
          "title": "Done",
          "outcome": "success"
        }
      ],
      "edges": [
        {
          "from": "plan",
          "to": "implement"
        },
        {
          "from": "implement",
          "to": "validate"
        },
        {
          "from": "validate",
          "to": "review",
          "condition": {
            "type": "node_status",
            "node": "validate",
            "equals": "success"
          }
        },
        {
          "from": "validate",
          "to": "fix",
          "condition": {
            "type": "node_status",
            "node": "validate",
            "equals": "failure"
          }
        },
        {
          "from": "fix",
          "to": "validate"
        },
        {
          "from": "review",
          "to": "release_notes",
          "condition": {
            "type": "review_status",
            "equals": "approved"
          }
        },
        {
          "from": "release_notes",
          "to": "done"
        }
      ]
    },
    "script": {
      "id": "script",
      "name": "script",
      "version": 1,
