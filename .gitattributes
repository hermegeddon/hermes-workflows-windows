* text=auto eol=lf

# Unified patches require a space marker even on empty context lines.
# Check the patched source for trailing whitespace, not these context markers.
docs/provider-patches/*.patch whitespace=-blank-at-eol

# Keep integrity-checked assets byte-for-byte identical across Windows clones.
hermes-workflows-py/dashboard/dist/** -text whitespace=cr-at-eol
hermes-workflows-py/dashboard/compat/** -text whitespace=cr-at-eol
hermes-workflows-py/dashboard/entry.js -text whitespace=cr-at-eol
hermes-workflows-py/dashboard/style.css -text whitespace=cr-at-eol
hermes-workflows-py/dashboard/manifest.json -text whitespace=cr-at-eol
hermes-workflows-py/desktop/plugin.js -text whitespace=cr-at-eol
