+def test_interleaved_owner_profiles_keep_secrets_and_destinations_separate(tmp_path, monkeypatch):
+    owners = []
+    for label in ("alpha", "beta"):
+        directory = tmp_path / label
+        directory.mkdir()
+        home, _ = home_with_provider(directory, monkeypatch)
+        (home / ".env").write_text(f"TEST_RECORD_KEY={label}-secret\n")
+        (home / "bank.txt").write_text(label)
+        owners.append((label, home, MemoryRecordClient(home, "record-consumer")))
+    def exercise(owner):
+        label, home, client = owner
+        context = {"session_id": f"run-{label}"}
+        description = client.describe(context)
+        assert description["status"] == "ready", description
+        result = client.write({"kind": "summary"}, context=context, effect_id=f"effect-{label}",
+                              expected_destination=description["destination"])
+        assert result["status"] == "acknowledged", result
+        entry = json.loads((home / "ledger.jsonl").read_text())
+        assert entry["key"] == f"{label}-secret"
+        assert entry["bank"] == label
+        return description["destination"]
+    with ThreadPoolExecutor(max_workers=2) as executor:
+        destinations = list(executor.map(exercise, owners))
+    assert destinations[0] != destinations[1]
+    _, home, client = owners[1]
+    assert client.write({"kind": "must-not-cross"}, context={"session_id": "run-alpha"},
+                        effect_id="cross-profile", expected_destination=destinations[0])["reason"] == "destination_changed"
+    assert len((home / "ledger.jsonl").read_text().splitlines()) == 1
