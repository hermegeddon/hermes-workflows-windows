+def test_timed_out_initialization_cannot_start_a_late_write_or_spawn_more_writers(tmp_path, monkeypatch):
+    home, _ = home_with_provider(tmp_path, monkeypatch)
+    entered, release, closed = threading.Event(), threading.Event(), threading.Event()
+    writes = []
+    class SlowProvider:
+        def record_capabilities(self): return {"write": True}
+        def is_available(self): return True
+        def initialize(self, *args, **kw):
+            entered.set()
+            assert release.wait(10)
+        def record_destination(self): return "a" * 64
+        def write_record(self, *args, **kw): writes.append(True)
+        def shutdown(self): closed.set()
+    import plugins.memory
+    monkeypatch.setattr(plugins.memory, "load_memory_provider", lambda *a, **kw: SlowProvider())
+    context = {"session_id": "run", "cwd": "", "platform": "workflow", "scheduled": False,
+               "user_id": "", "user_id_alt": "", "parent_session_id": ""}
+    binding = hashlib.sha256(json.dumps([str(home.resolve()), "recordtest", "a" * 64, context], sort_keys=True).encode()).hexdigest()
+    client = MemoryRecordClient(home, "record-consumer")
+    try:
+        result = client.write({"body": "test"}, context=context, effect_id="effect-1", timeout=2,
+                              expected_destination={"home": str(home.resolve()), "provider": "recordtest", "binding": binding})
+        assert entered.is_set()
+        assert result == {"status": "unknown", "reason": "deadline_exceeded"}
+        assert client.describe(context)["reason"] == "writer_busy"
+    finally:
+        release.set()
+        assert closed.wait(5)
+    assert writes == []
