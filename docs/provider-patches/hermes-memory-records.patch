index 0000000000..4b62549de3
--- /dev/null
+++ b/hermes_cli/plugins_memory_ctx.py
@@ -0,0 +1,55 @@
+"""Additive JSON-only memory-record bridge for in-process and hosted plugins."""
+
+from __future__ import annotations
+
+import logging
+from typing import Any
+
+logger = logging.getLogger(__name__)
+
+
+class PluginMemoryCtxMixin:
+    def register_memory_provider(self, provider) -> None:
+        """Record an inert provider; activation is owned by memory.provider."""
+        from agent.memory_provider import MemoryProvider
+
+        if self._wrong_type(provider, MemoryProvider, "memory provider"):
+            return
+        self._memory_provider = provider
+        logger.debug("Plugin '%s' registered memory provider: %s", self.manifest.name,
+                     getattr(provider, "name", "?"))
+
+    def _memory_record_client(self):
+        from hermes_cli.plugin_memory_records import MemoryRecordClient
+
+        return MemoryRecordClient(self._manager.home_path, self.plugin_id)
+
+    def memory_record_status(self) -> dict[str, Any]:
+        """Configuration-only status. Does not initialize a memory provider."""
+        from hermes_cli.config_backend import ConfigBackendUnavailable
+
+        try:
+            return self._memory_record_client().status()
+        except (ConfigBackendUnavailable, Exception):  # health: allow BLE001 -- config boundary degrades without publishing config or credential text
+            return {"api_version": 1, "status": "unavailable", "reason": "config_unavailable"}
+
+    def describe_memory_writer(self, context: dict[str, Any], *, timeout: float = 5) -> dict[str, Any]:
+        """Bind a consented explicit writer; unsupported providers remain inert."""
+        return self._memory_record_client().describe(context, timeout=timeout)
+
+    def write_memory_record(self, record: dict[str, Any], *, context: dict[str, Any],
+                            effect_id: str, expected_destination: dict[str, Any],
+                            timeout: float = 5) -> dict[str, Any]:
+        """Write at the frozen destination, with bounded execution and an honest receipt."""
+        return self._memory_record_client().write(
+            record, context=context, effect_id=effect_id,
+            expected_destination=expected_destination, timeout=timeout,
+        )
+
+    def lookup_memory_record(self, *, context: dict[str, Any], effect_id: str,
+                             expected_destination: dict[str, Any], timeout: float = 5) -> dict[str, Any]:
+        """Reconcile a receipt read-only. This never repeats an ambiguous write."""
+        return self._memory_record_client().lookup(
+            context=context, effect_id=effect_id,
+            expected_destination=expected_destination, timeout=timeout,
+        )
