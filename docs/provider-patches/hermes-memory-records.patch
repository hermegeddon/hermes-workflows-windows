+@pytest.mark.parametrize("isolation", ["in_process", "host"])
+@pytest.mark.platforms("any")
+def test_real_provider_and_consumer_discovery_use_scoped_public_record_calls(tmp_path, monkeypatch, isolation):
+    from hermes_cli import plugins as plugins_mod
+    from hermes_cli.plugins import PluginManager
+    from tools.registry import registry
+
+    home, _ = home_with_provider(tmp_path, monkeypatch, isolation=isolation)
+    empty = tmp_path / "bundled"
+    empty.mkdir()
+    monkeypatch.setattr(plugins_mod, "get_bundled_plugins_dir", lambda: empty)
+    manager = PluginManager()
+    manager.discover_and_load()
+    context = {"session_id": "workflow-run"}
+    def call(operation, **arguments):
+        return json.loads(registry.dispatch("record_consumer", {"operation": operation, **arguments}, scope=manager.scope_key))
+    try:
+        description = call("describe_memory_writer", context=context, timeout=15)
+        assert description["status"] == "ready", description
+        destination = description["destination"]
+        assert destination["home"] == str(home.resolve())
+        assert call("write_memory_record", context=context, effect_id="effect-1", expected_destination=destination,
+                    record={"body": "password=synthetic-secret"}, timeout=15)["status"] == "acknowledged"
+        assert call("lookup_memory_record", context=context, effect_id="effect-1", expected_destination=destination,
+                    timeout=15)["status"] == "acknowledged"
+        ledger = [json.loads(line) for line in (home / "ledger.jsonl").read_text().splitlines()]
+        assert len(ledger) == 1
+        record = ledger[0].pop("record")
+        assert "synthetic-secret" not in json.dumps(record)
+        assert record["body"].startswith("password=")
+        assert ledger == [{"id": "effect-1", "bank": "bank-a", "key": "owner-secret"}]
+        (home / "bank.txt").write_text("bank-b")
+        assert call("write_memory_record", context=context, effect_id="effect-2", expected_destination=destination,
+                    record={"body": "new bank must be refused"}, timeout=15)["reason"] == "destination_changed"
+        assert len((home / "ledger.jsonl").read_text().splitlines()) == 1
+    finally:
+        manager.unload()
+        host = getattr(manager, "_plugin_host_instance", None)
+        if host is not None:
+            host.shutdown()
+
