diff --git a/hermes_cli/plugin_memory_records.py b/hermes_cli/plugin_memory_records.py
new file mode 100644
index 0000000000..34881459fe
--- /dev/null
+++ b/hermes_cli/plugin_memory_records.py
@@ -0,0 +1,240 @@
+"""Host-owned, consented record writes through the selected memory provider.
+
+Public headless companion to PluginContext's memory-record methods. No agent,
+model call, native-memory write or provider-specific tool guessing is involved.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import re
+import threading
+import time
+from pathlib import Path
+from typing import Any
+
+CAPABILITY = "memory.write_records"
+SCHEDULED_CAPABILITY = "memory.write_scheduled_records"
+_LOCK = threading.Lock()
+_ACTIVE: set[tuple[str, str]] = set()
+
+
+def _config(home: Path) -> dict:
+    from hermes_cli.config import load_config_readonly
+    from hermes_cli.plugins_loader import _plugin_home_scope
+
+    with _plugin_home_scope(home):
+        return load_config_readonly() or {}
+
+
+def _selection(config: dict) -> str:
+    from agent.memory_provider import is_core_memory_provider
+
+    name = str(config.get("memory", {}).get("provider") or "").strip()
+    return "" if is_core_memory_provider(name) else name
+
+
+def _consented(config: dict, plugin_id: str, capability=CAPABILITY) -> bool:
+    from hermes_cli.plugin_capabilities import plugin_capability_granted
+
+    return plugin_capability_granted(plugin_id, capability, config=config)
+
+
+def _context(context: dict) -> dict:
+    fields = {"session_id", "cwd", "platform", "user_id", "user_id_alt", "parent_session_id", "scheduled"}
+    if not isinstance(context, dict) or set(context) - fields:
+        raise ValueError("invalid memory record context")
+    session = context.get("session_id")
+    scheduled = context.get("scheduled", False)
+    if not isinstance(session, str) or not session or len(session) > 512:
+        raise ValueError("memory record context requires a session id")
+    if type(scheduled) is not bool:
+        raise ValueError("invalid memory record context fields")
+    result = {"session_id": session, "scheduled": scheduled}
+    for field in ("cwd", "platform", "user_id", "user_id_alt", "parent_session_id"):
+        value = context.get(field, "workflow" if field == "platform" else "")
+        if not isinstance(value, str) or len(value) > (4096 if field == "cwd" else 512):
+            raise ValueError("invalid memory record context fields")
+        result[field] = value
+    return result
+
+
+def _capabilities(provider) -> dict:
+    raw = provider.record_capabilities()
+    if not isinstance(raw, dict):
+        return {"write": False, "lookup": False, "idempotency": False}
+    return {key: raw.get(key) is True for key in ("write", "lookup", "idempotency")}
+
+
+def _receipt(raw: Any) -> dict:
+    if not isinstance(raw, dict) or raw.get("status") not in {"queued", "acknowledged", "failed", "unknown"}:
+        return {"status": "unknown", "reason": "malformed_receipt"}
+    result = {"status": raw["status"]}
+    identity = raw.get("receipt_id")
+    if isinstance(identity, str) and 0 < len(identity) <= 256:
+        from agent.memory_manager import _redact_for_provider
+        result["receipt_id"] = _redact_for_provider(identity)
+    return result
+
+
+class MemoryRecordClient:
+    """One immutable owner profile/plugin pair; caller-supplied homes never cross ctx RPC.
+
+    Timed-out work retains its slot until cleanup ends. A second call cannot
+    multiply stalled writers. The caller owns durable intent and reconciliation.
+    """
+
+    def __init__(self, home: Path, plugin_id: str):
+        self.home = Path(home).resolve()
+        self.plugin_id = plugin_id
+
+    def status(self) -> dict:
+        """Read configuration only; do not load/initialize a provider or fetch its secrets."""
+        config = _config(self.home)
+        return {"api_version": 1, "provider": _selection(config) or None,
+                "consented": _consented(config, self.plugin_id), "provider_support": "unprobed"}
+
+    def describe(self, context: dict, *, timeout: float = 5) -> dict:
+        return self._call("describe", _context(context), timeout=timeout)
+
+    def write(self, record: dict, *, context: dict, effect_id: str,
+              expected_destination: dict, timeout: float = 5) -> dict:
+        encoded = json.dumps(record)
+        if not isinstance(record, dict) or len(encoded.encode()) > 32768:
+            raise ValueError("memory record must be an object of at most 32768 bytes")
+        if not isinstance(effect_id, str) or not re.fullmatch(r"[a-zA-Z0-9_.:-]{1,128}", effect_id):
+            raise ValueError("invalid memory record effect identity")
+        return self._call("write", _context(context), timeout=timeout, record=json.loads(encoded),
+                          effect_id=effect_id, expected_destination=dict(expected_destination))
+
+    def lookup(self, *, context: dict, effect_id: str, expected_destination: dict,
+               timeout: float = 5) -> dict:
+        return self._call("lookup", _context(context), timeout=timeout, effect_id=effect_id,
+                          expected_destination=dict(expected_destination))
+
+    def _call(self, operation, context, *, timeout, **arguments):
+        if isinstance(timeout, bool) or not isinstance(timeout, (int, float)) or not math.isfinite(timeout) or not 0 < timeout <= 30:
+            raise ValueError("memory record deadline must be positive and at most 30 seconds")
+        from hermes_constants import hermes_home_key
+
+        key = (hermes_home_key(self.home), self.plugin_id)
+        with _LOCK:
+            if key in _ACTIVE:
+                return {"status": "unavailable", "reason": "writer_busy"}
+            _ACTIVE.add(key)
+        finished = threading.Event()
+        result = []
+        deadline = time.monotonic() + timeout
+
+        def work():
+            try:
+                result.append(self._invoke(operation, context, deadline, arguments))
+            except (Exception, SystemExit):  # health: allow BLE001 -- provider boundary must not leak credential-bearing exception text
+                result.append({"status": "unknown" if operation == "write" else "unavailable",
+                               "reason": "provider_call_unconfirmed"})
+            finally:
+                with _LOCK:
+                    _ACTIVE.discard(key)
+                finished.set()
+
+        from agent.memory_provider import spawn_context_thread
+
+        worker = spawn_context_thread(work, name="memory-record-writer")
+        try:
+            worker.start()
+        except BaseException:
+            with _LOCK:
+                _ACTIVE.discard(key)
+            raise
+        if not finished.wait(timeout):
+            return {"status": "unknown" if operation == "write" else "unavailable",
+                    "reason": "deadline_exceeded"}
+        return result[0]
+
+    def _invoke(self, operation, context, deadline, arguments):
+        from agent.secret_scope import (
+            build_profile_secret_scope, reset_multiplex_context, reset_secret_scope,
+            set_multiplex_context, set_secret_scope,
+        )
+        from hermes_cli.plugins_loader import _plugin_home_scope
+
+        with _plugin_home_scope(self.home):
+            config = _config(self.home)
+            if not _consented(config, self.plugin_id):
+                return {"status": "unavailable", "reason": "not_consented"}
+            name = _selection(config)
+            if not name:
+                return {"status": "unavailable", "reason": "no_external_provider"}
+            if context["scheduled"] and not _consented(config, self.plugin_id, SCHEDULED_CAPABILITY):
+                return {"status": "unavailable", "reason": "scheduled_records_disabled"}
+            multiplex = set_multiplex_context(True)
+            try:
+                secrets = set_secret_scope(build_profile_secret_scope(self.home), profile_home=str(self.home))
+                try:
+                    resolved = dict(context)
+                    if not resolved["cwd"]:
+                        resolved["cwd"] = str(config.get("terminal", {}).get("cwd") or "")
+                    return self._provider_call(name, operation, resolved, deadline, arguments)
+                finally:
+                    reset_secret_scope(secrets)
+            finally:
+                reset_multiplex_context(multiplex)
+
+    def _provider_call(self, name, operation, context, deadline, arguments):
+        from hermes_cli.profiles import get_active_profile_name
+        from plugins.memory import load_memory_provider
+
+        provider = load_memory_provider(name, register_skills=False)
+        if provider is None:
+            return {"status": "unavailable", "reason": "provider_unavailable"}
+        capabilities = _capabilities(provider)
+        if not capabilities["write"]:
+            return {"status": "unavailable", "reason": "capability_unavailable"}
+        if operation == "lookup" and not capabilities["lookup"]:
+            return {"status": "unknown", "reason": "lookup_unsupported"}
+        if not provider.is_available():
+            return {"status": "unavailable", "reason": "provider_unavailable"}
+        try:
+            provider.initialize(
+                context["session_id"], hermes_home=str(self.home), platform=context["platform"],
+                agent_context="cron" if context["scheduled"] else "workflow",
+                agent_identity=get_active_profile_name(), agent_workspace="hermes", cwd=context["cwd"],
+                user_id=context["user_id"], user_id_alt=context["user_id_alt"],
+                parent_session_id=context["parent_session_id"],
+            )
+            capabilities = _capabilities(provider)
+            if not capabilities["write"]:
+                return {"status": "unavailable", "reason": "capability_unavailable"}
+            token = provider.record_destination()
+            if not isinstance(token, str) or not re.fullmatch(r"[0-9a-f]{64}", token):
+                return {"status": "unavailable", "reason": "destination_unsupported"}
+            binding = hashlib.sha256(json.dumps(
+                [str(self.home), name, token, context], sort_keys=True
+            ).encode()).hexdigest()
+            destination = {"home": str(self.home), "provider": name, "binding": binding}
+            if operation == "describe":
+                return {"api_version": 1, "status": "ready", "destination": destination,
+                        "capabilities": capabilities, "context": context}
+            if arguments.get("expected_destination") != destination:
+                return {"status": "failed", "reason": "destination_changed"}
+            # Revalidate selection/consent before accepting a write, while the
+            # initialized provider instance keeps its own destination pinned.
+            current = _config(self.home)
+            if not _consented(current, self.plugin_id) or _selection(current) != name or (
+                context["scheduled"] and not _consented(current, self.plugin_id, SCHEDULED_CAPABILITY)
+            ):
+                return {"status": "failed", "reason": "selection_changed"}
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                return {"status": "failed", "reason": "deadline_before_acceptance"}
+            kwargs = {"effect_id": arguments["effect_id"], "expected_destination": token,
+                      "timeout": remaining}
+            if operation == "lookup":
+                return _receipt(provider.lookup_record(**kwargs))
+            from agent.memory_manager import _redact_for_provider
+
+            return _receipt(provider.write_record(_redact_for_provider(arguments["record"]), **kwargs))
+        finally:
+            provider.shutdown()
