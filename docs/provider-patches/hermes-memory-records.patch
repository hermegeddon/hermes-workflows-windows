@@ -0,0 +1,253 @@
+"""Explicit memory-record consent, destination fencing and hosted compatibility."""
+
+import hashlib
+import json
+import threading
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+
+import hermes_yaml as yaml
+import pytest
+
+from agent.memory_provider import MemoryProvider
+from hermes_cli.plugin_memory_records import MemoryRecordClient
+
+
+PROVIDER = '''
+import hashlib, json
+from pathlib import Path
+from agent.memory_provider import MemoryProvider
+from agent.secret_scope import get_secret
+from hermes_constants import get_hermes_home
+
+class Ledger(MemoryProvider):
+    name = 'recordtest'
+    def is_available(self): return True
+    def get_tool_schemas(self): return []
+    def initialize(self, session_id, **kw):
+        self.home = Path(kw['hermes_home'])
+        assert self.home == get_hermes_home()
+        self.bank = (self.home / 'bank.txt').read_text()
+        self.key = get_secret('TEST_RECORD_KEY')
+    def record_capabilities(self):
+        return {'write': True, 'lookup': True, 'idempotency': True}
+    def record_destination(self):
+        return hashlib.sha256((str(self.home) + self.bank).encode()).hexdigest()
+    def write_record(self, record, *, effect_id, expected_destination, timeout):
+        assert expected_destination == self.record_destination()
+        path = self.home / 'ledger.jsonl'
+        prior = path.read_text() if path.exists() else ''
+        if not any(json.loads(line)['id'] == effect_id for line in prior.splitlines()):
+            with path.open('a') as stream:
+                stream.write(json.dumps({'id': effect_id, 'bank': self.bank, 'key': self.key, 'record': record}) + '\\n')
+        return {'status': 'acknowledged', 'receipt_id': effect_id}
+    def lookup_record(self, *, effect_id, expected_destination, timeout):
+        assert expected_destination == self.record_destination()
+        path = self.home / 'ledger.jsonl'
+        if path.exists() and any(json.loads(line)['id'] == effect_id for line in path.read_text().splitlines()):
+            return {'status': 'acknowledged', 'receipt_id': effect_id}
+        return {'status': 'unknown'}
+def register(ctx): ctx.register_memory_provider(Ledger())
+'''
+
+CONSUMER = '''
+import json
+def register(ctx):
+    def call(args, **kw):
+        operation = args.pop('operation')
+        return json.dumps(getattr(ctx, operation)(**args))
+    ctx.register_tool(name='record_consumer', toolset='record_consumer',
+        schema={'name': 'record_consumer', 'description': 'Test writer',
+                'parameters': {'type': 'object', 'properties': {}}}, handler=call)
+'''
+
+
+def home_with_provider(tmp_path, monkeypatch, *, consent=True, isolation="in_process"):
+    home = tmp_path / "owner"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("HOME", str(tmp_path / "os-home"))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path / "os-home")
+    config = {
+        "memory": {"provider": "recordtest"},
+        "plugins": {"enabled": ["record-consumer"], "isolation": isolation,
+                    "entries": {"record-consumer": {
+                        "granted_capabilities": ["memory.write_records"] if consent else []}}},
+    }
+    (home / "config.yaml").write_text(yaml.safe_dump(config))
+    (home / ".env").write_text("TEST_RECORD_KEY=owner-secret\n")
+    (home / "bank.txt").write_text("bank-a")
