+"""Optional explicit-record capability; conversation capture remains unchanged."""
+
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import json
+import math
+import re
+import time
+
+
+class RecordWriterMixin:
+    def record_capabilities(self):
+        # The existing context-only mode does not permit explicit writes.
+        return {"write": self._memory_mode != "context", "lookup": False, "idempotency": False}
+
+    def _record_target(self):
+        if not self.record_capabilities()["write"] or self._shutting_down.is_set():
+            return "", ()
+        banks = tuple(self._write_bank_ids)
+        identity = [
+            self._mode, self._api_url,
+            hashlib.sha256(str(self._api_key or "").encode()).hexdigest(),
+            banks, self._memory_mode, self._retain_async, self._retain_strategy,
+            self._retain_tags, self._observation_scopes,
+        ]
+        return hashlib.sha256(json.dumps(identity, sort_keys=True).encode()).hexdigest(), banks
+
+    def record_destination(self):
+        return self._record_target()[0]
+
+    def write_record(self, record, *, effect_id, expected_destination, timeout):
+        if (
+            not isinstance(record, dict)
+            or not isinstance(effect_id, str)
+            or not re.fullmatch(r"[a-zA-Z0-9_.:-]{1,128}", effect_id)
+            or isinstance(timeout, bool)
+            or not isinstance(timeout, (int, float))
+            or not math.isfinite(timeout)
+            or not 0 < timeout <= 30
+        ):
+            return {"status": "failed", "reason": "invalid_record_request"}
+        # Capture the exact bank tuple used to compute the acceptance binding.
+        # A session switch cannot substitute a new tuple during dispatch.
+        token, banks = self._record_target()
+        if not token or token != expected_destination:
+            return {"status": "failed", "reason": "destination_changed"}
+        deadline = time.monotonic() + timeout
+        item = self._build_retain_kwargs(
+            json.dumps(record, sort_keys=True, ensure_ascii=False),
+            context="Explicit Hermes record",
+            metadata={"source": self._retain_source, "client_record_id": effect_id},
+        )
+        client = self._get_client()
+        if time.monotonic() >= deadline:
+            return {"status": "failed", "reason": "deadline_before_acceptance"}
+
+        async def deliver():
+            queued = bool(self._retain_async)
+            for bank in banks:
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    raise TimeoutError("record deadline")
+                # Do not use the embedded reconnect/retry wrapper: an ambiguous
+                # POST may already have written and must never be blindly replayed.
+                response = await asyncio.wait_for(client.aretain_batch(
+                    bank_id=bank, items=[item], document_id=f"hermes-record-{effect_id}",
+                    retain_async=self._retain_async,
+                ), remaining)
+                if getattr(response, "success", None) is False:
+                    return {"status": "unknown", "reason": "retain_unconfirmed"}
+                queued = queued or bool(getattr(response, "operation_id", None)) or bool(
+                    getattr(response, "operation_ids", None)
+                )
+            return {"status": "queued" if queued else "acknowledged"}
+
+        from agent.async_utils import safe_schedule_threadsafe
+        from . import _get_loop
+
+        loop = _get_loop()
+        operation = deliver()
+        future = safe_schedule_threadsafe(operation, loop)
+        if future is None:
+            operation.close()
+            return {"status": "failed", "reason": "writer_unavailable"}
+        try:
+            return future.result(timeout=max(0, deadline - time.monotonic()))
+        except Exception:
+            # Cancels pending awaits/bank sends. An accepted server write can
+            # still complete: unknown is deliberate, not permission to resend.
+            future.cancel()
+            return {"status": "unknown", "reason": "retain_unconfirmed"}
+
+    def lookup_record(self, *, effect_id, expected_destination, timeout):
+        # The existing public API has no durable lookup by client effect id.
+        return {"status": "unknown", "reason": "lookup_unsupported"}
