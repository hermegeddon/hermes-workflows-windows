+"""The actual provider's optional record interface with an injected SDK only."""
+
+import asyncio
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from conftest import FakeClient
+
+
+def write(instance, **changes):
+    return instance.write_record(
+        {"kind": "run_completed", "status": "completed"},
+        effect_id="effect-1", expected_destination=instance.record_destination(),
+        timeout=changes.get("timeout", 2),
+    )
+
+
+def test_explicit_async_record_is_queued_without_a_conversation_or_recall(provider):
+    instance, client = provider({"bank_id": "owner", "retain_tags": "configured-tag", "auto_retain": False})
+    try:
+        assert instance.record_capabilities() == {"write": True, "lookup": False, "idempotency": False}
+        assert write(instance) == {"status": "queued"}
+        assert len(client.retains) == 1
+        call = client.retains[0]
+        assert call["bank_id"] == "owner"
+        assert call["document_id"] == "hermes-record-effect-1"
+        item = call["items"][0]
+        assert json.loads(item["content"]) == {"kind": "run_completed", "status": "completed"}
+        assert "configured-tag" in item["tags"]
+        assert item["metadata"]["client_record_id"] == "effect-1"
+        assert instance._session_turns == []
+        assert not client.recalls and not client.reflects
+    finally:
+        instance.shutdown()
+
+
+def test_synchronous_success_is_durable_and_all_existing_write_banks_are_preserved(provider):
+    instance, client = provider({"bank_id": "primary", "additional_banks": ["mirror"], "retain_async": False})
+    try:
+        assert write(instance) == {"status": "acknowledged"}
+        assert [call["bank_id"] for call in client.retains] == ["primary", "mirror"]
+    finally:
+        instance.shutdown()
+
+
+def test_changed_bank_or_key_rejects_the_original_binding(provider):
+    instance, client = provider({"bank_id": "original"})
+    try:
+        original = instance.record_destination()
+        instance._write_bank_ids = ["changed"]
+        assert instance.write_record({}, effect_id="e", expected_destination=original, timeout=2)["status"] == "failed"
+        assert client.retains == []
+        changed = instance.record_destination()
+        instance._api_key = "different-tenant"
+        assert instance.record_destination() != changed
+    finally:
+        instance.shutdown()
+
+
+def test_context_only_and_shutdown_instances_cannot_accept_records(provider):
+    instance, client = provider({"memory_mode": "context"})
+    assert instance.record_capabilities()["write"] is False
+    assert instance.record_destination() == ""
+    assert write(instance)["status"] == "failed"
+    instance.shutdown()
+    assert write(instance)["status"] == "failed"
+    assert client.retains == []
+
+
+def test_partial_multi_bank_failure_is_unknown_and_never_retried(provider):
+    class Partial(FakeClient):
+        async def aretain_batch(self, **kwargs):
+            self.retains.append(kwargs)
+            if len(self.retains) == 2:
+                raise ConnectionError("cannot connect to host")
+            return SimpleNamespace()
+    instance, client = provider({"bank_id": "primary", "additional_banks": ["mirror"]}, client=Partial())
+    try:
+        assert write(instance)["status"] == "unknown"
+        assert [call["bank_id"] for call in client.retains] == ["primary", "mirror"]
+        assert instance.lookup_record(effect_id="effect-1", expected_destination=instance.record_destination(), timeout=2)["status"] == "unknown"
+        assert len(client.retains) == 2
+    finally:
+        instance.shutdown()
+
+
+def test_timeout_after_acceptance_is_unknown_and_cancels_pending_sdk_work(provider):
+    class Slow(FakeClient):
+        cancelled = False
+        async def aretain_batch(self, **kwargs):
+            self.retains.append(kwargs)
+            try:
+                await asyncio.Event().wait()
+            except asyncio.CancelledError:
+                self.cancelled = True
+                raise
+    instance, client = provider({}, client=Slow())
+    try:
+        assert write(instance, timeout=2)["status"] == "unknown"
+        assert len(client.retains) == 1
+        # The provider-side operation is read-only on reconciliation.
+        assert instance.lookup_record(effect_id="effect-1", expected_destination=instance.record_destination(), timeout=2)["reason"] == "lookup_unsupported"
+        assert len(client.retains) == 1
+    finally:
+        instance.shutdown()
+    assert client.cancelled
+
+
+@pytest.mark.parametrize("timeout", [0, -1, float("nan"), float("inf"), True, 31])
+def test_invalid_deadline_never_dispatches(provider, timeout):
+    instance, client = provider({})
+    try:
+        assert write(instance, timeout=timeout)["status"] == "failed"
+        assert client.retains == []
+    finally:
+        instance.shutdown()
