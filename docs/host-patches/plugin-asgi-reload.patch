+@pytest.mark.platforms("any")
+def test_rediscovery_refreshes_dashboard_only_secondary_host(daemon, monkeypatch, tmp_path):
+    """A secondary dashboard host may never load a backend, but still owns cached routers."""
+    monkeypatch.setattr(PluginHost, "asgi_request", _REAL_ASGI_REQUEST)
+    monkeypatch.setattr(plugins_mod, "get_bundled_plugins_dir", lambda: tmp_path / "no-bundled")
+    _beta_plugin(daemon, isolation="in_process")
+    api = daemon.beta / "plugins" / NAME / "dashboard" / "plugin_api.py"
+
+    def write(version):
+        api.write_text(
+            "import os\nfrom fastapi import APIRouter\nrouter = APIRouter()\n"
+            "@router.get('/version')\ndef version():\n"
+            f" return {{'version': {version!r}, 'pid': os.getpid()}}\n",
+            encoding="utf-8",
+        )
+
+    def request():
+        response = daemon.client.get(f"/api/plugins/{NAME}/version", headers=daemon.beta_ticket())
+        assert response.status_code == 200, response.text
+        return response.json()
+
+    try:
+        write("before")
+        before = request()
+        assert before["version"] == "before" and before["pid"] != os.getpid()
+        manager = plugins_mod._plugin_managers_by_home[daemon.beta.resolve()]
+        assert NAME not in manager._plugins  # dashboard-only package, never a host.load()
+        write("after explicit rediscovery")
+        manager.discover_and_load(force=True)
+        after = request()
+        assert after == {"version": "after explicit rediscovery", "pid": before["pid"]}
+    finally:
+        _shutdown_hosts()
+
+
 def _asgi_client():
     """An async client on the real app, so one test can hold requests in flight side by side."""
     import httpx
